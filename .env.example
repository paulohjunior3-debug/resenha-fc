# Supabase (Configurações do projeto > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Somente uso no servidor (Route Handlers/Server Actions). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Domínio interno usado para gerar o e-mail sintético de login por apelido
# (não precisa ser um domínio real, é apenas o identificador interno do Supabase Auth)
AUTH_INTERNAL_EMAIL_DOMAIN=resenhafc.internal
